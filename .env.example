# Copy to .env (setup.bat does this) and fill in. Never commit .env.

# Kite Connect app (https://developers.kite.trade/apps)
# Set the app's Redirect URL to: http://127.0.0.1:8000/api/kite/callback
KITE_API_KEY=
KITE_API_SECRET=

# Local server. Keep HOST on 127.0.0.1 so nothing outside this laptop can reach it.
HOST=127.0.0.1
PORT=8000

# Telegram (Phase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM for the journal and weekly-review explanations only (it never decides a trade): anthropic, ollama or template
# anthropic: Claude Sonnet 5.5 via the API (key from console.anthropic.com; prepaid credits)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ollama: a local model (free); set OLLAMA_MODEL to one you have pulled, e.g. mistral
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Running on a server (see deploy/SERVER_SETUP.md). deploy/install.sh sets the first two.
# PUBLIC_URL: the dashboard's address as you open it (your Tailscale name). The Kite redirect URL becomes
#   PUBLIC_URL/api/kite/callback. With PUBLIC_URL set, the agent refuses to start without DASHBOARD_AUTH=required.
PUBLIC_URL=
DASHBOARD_AUTH=off
# Uptime check: a URL pinged every 5 minutes (e.g. a free Healthchecks.io check); it alerts you if pings stop.
HEALTHCHECK_URL=
